NODE_ENV=development
PORT=3000
# Session pooler de Supabase (IPv4). La conexión directa db.<ref>.supabase.co es solo IPv6.
DATABASE_URL=postgresql://postgres.azokshimfbitsncidgdt:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://azokshimfbitsncidgdt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Mínimo 16 caracteres; lo usan los programadores externos para /v1/jobs/*
JOB_TOKEN=
# Origen exacto del front (CORS)
FRONT_ORIGIN=http://localhost:5173
# Resend o Brevo (fase 6)
MAIL_API_KEY=
# Clave publishable/anon (pública por diseño); con ella la API inicia sesión de los usuarios
SUPABASE_ANON_KEY=
# Dominio de los correos sintéticos de las cuentas (jperez@<dominio>); nunca se envía un correo
AUTH_EMAIL_DOMAIN=usuarios.reparto.test
# Clave de OpenRouteService (plan gratuito, account.heigit.org): con ella la ruta usa tiempos de manejar por calles. Opcional; sin ella mide en línea recta.
ORS_API_KEY=
